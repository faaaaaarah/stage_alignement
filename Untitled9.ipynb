      "source": [
        "!pip install fuzzywuzzy python-Levenshtein\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import unicodedata\n",
        "from fuzzywuzzy import fuzz\n",
        "from datetime import datetime\n",
        "\n",
        "# ========================\n",
        "# 1. Normalisation\n",
        "# ========================\n",
        "\n",
        "def normalize_name(name):\n",
        "    \"\"\"Nettoyer et normaliser les noms\"\"\"\n",
        "    if pd.isna(name):\n",
        "        return \"\"\n",
        "    name = str(name).lower().strip()\n",
        "    # enlever accents\n",
        "    name = unicodedata.normalize(\"NFD\", name).encode(\"ascii\", \"ignore\").decode(\"utf-8\")\n",
        "    # enlever ponctuation basique\n",
        "    for char in [\".\", \"-\", \",\", \"_\"]:\n",
        "        name = name.replace(char, \" \")\n",
        "    return \" \".join(name.split())\n",
        "\n",
        "def normalize_blood(blood):\n",
        "    \"\"\"Normaliser groupe sanguin\"\"\"\n",
        "    if pd.isna(blood):\n",
        "        return \"\"\n",
        "    blood = str(blood).strip().upper().replace(\" \", \"\")\n",
        "    mapping = {\n",
        "        \"O+\": [\"O POS\", \"0+\", \"O POSITIF\", \"O+\"],\n",
        "        \"O-\": [\"O NEG\", \"0-\", \"O-\", \"O NEGATIF\"],\n",
        "        \"A+\": [\"A POS\", \"A+\", \"A POSITIF\"],\n",
        "        \"A-\": [\"A-\", \"A NEG\", \"A NEGATIF\"],\n",
        "        \"B+\": [\"B POS\", \"B+\", \"B POSITIF\"],\n",
        "        \"B-\": [\"B-\", \"B NEG\"],\n",
        "        \"AB+\": [\"AB+\", \"AB POS\", \"AB POSITIF\"],\n",
        "        \"AB-\": [\"AB-\", \"AB NEG\"]\n",
        "    }\n",
        "    for norm, variants in mapping.items():\n",
        "        if blood in variants:\n",
        "            return norm\n",
        "    return blood\n",
        "\n",
        "def normalize_gender(g):\n",
        "    \"\"\"Normaliser le genre\"\"\"\n",
        "    if pd.isna(g): return \"U\"\n",
        "    g = str(g).strip().lower()\n",
        "    if g in [\"m\", \"male\", \"masculin\", \"man\", \"homme\"]: return \"M\"\n",
        "    if g in [\"f\", \"female\", \"feminin\", \"woman\", \"femme\"]: return \"F\"\n",
        "    return \"U\"\n",
        "\n",
        "def preprocess(df):\n",
        "    df = df.copy()\n",
        "    df[\"Name\"] = df[\"Name\"].apply(normalize_name)\n",
        "    df[\"Blood Type\"] = df[\"Blood Type\"].apply(normalize_blood)\n",
        "    df[\"Gender\"] = df[\"Gender\"].apply(normalize_gender)\n",
        "    df[\"Date of Admission\"] = pd.to_datetime(df[\"Date of Admission\"], errors=\"coerce\", dayfirst=True)\n",
        "    df[\"Age\"] = pd.to_numeric(df[\"Age\"], errors=\"coerce\")\n",
        "    # année de naissance estimée si Age + Admission connus\n",
        "    df[\"birth_year\"] = np.where(\n",
        "        df[\"Age\"].notna() & df[\"Date of Admission\"].notna(),\n",
        "        df[\"Date of Admission\"].dt.year - df[\"Age\"],\n",
        "        np.nan\n",
        "    )\n",
        "    return df\n",
        "\n",
        "# ========================\n",
        "# 2. Chargement datasets\n",
        "# ========================\n",
        "\n",
        "df1 = pd.read_csv(\"healthcare_dataset.csv\")\n",
        "df2 = pd.read_csv(\"healthcare_dataset2.csv\")\n",
        "\n",
        "df1 = preprocess(df1)\n",
        "df2 = preprocess(df2)\n",
        "\n",
        "# ========================\n",
        "# 3. Fonction de similarité\n",
        "# ========================\n",
        "\n",
        "def compute_similarity(row1, row2):\n",
        "    score, total_weight = 0, 0\n",
        "\n",
        "    # Pondérations ajustées\n",
        "    w_name, w_blood, w_gender, w_age, w_adm, w_birth = 0.45, 0.15, 0.05, 0.1, 0.1, 0.15\n",
        "\n",
        "    # Nom (fuzzy robuste)\n",
        "    if row1[\"Name\"] and row2[\"Name\"]:\n",
        "        name_score = max(\n",
        "            fuzz.token_sort_ratio(row1[\"Name\"], row2[\"Name\"]),\n",
        "            fuzz.token_set_ratio(row1[\"Name\"], row2[\"Name\"])\n",
        "        ) / 100\n",
        "        score += name_score * w_name\n",
        "    total_weight += w_name\n",
        "\n",
        "    # Groupe sanguin\n",
        "    if row1[\"Blood Type\"] == row2[\"Blood Type\"] and row1[\"Blood Type\"] != \"\":\n",
        "        score += 1 * w_blood\n",
        "    total_weight += w_blood\n",
        "\n",
        "    # Genre\n",
        "    if row1[\"Gender\"] == row2[\"Gender\"] and row1[\"Gender\"] != \"U\":\n",
        "        score += 1 * w_gender\n",
        "    total_weight += w_gender\n",
        "\n",
        "    # Âge (±2 ans)\n",
        "    if pd.notna(row1[\"Age\"]) and pd.notna(row2[\"Age\"]):\n",
        "        if abs(row1[\"Age\"] - row2[\"Age\"]) <= 2:\n",
        "            score += 1 * w_age\n",
        "    total_weight += w_age\n",
        "\n",
        "    # Date admission (±30 jours)\n",
        "    if pd.notna(row1[\"Date of Admission\"]) and pd.notna(row2[\"Date of Admission\"]):\n",
        "        if abs((row1[\"Date of Admission\"] - row2[\"Date of Admission\"]).days) <= 30:\n",
        "            score += 1 * w_adm\n",
        "    total_weight += w_adm\n",
        "\n",
        "    # Année de naissance (±1 an)\n",
        "    if pd.notna(row1[\"birth_year\"]) and pd.notna(row2[\"birth_year\"]):\n",
        "        if abs(row1[\"birth_year\"] - row2[\"birth_year\"]) <= 1:\n",
        "            score += 1 * w_birth\n",
        "    total_weight += w_birth\n",
        "\n",
        "    return score / total_weight if total_weight > 0 else 0\n",
        "\n",
        "# ========================\n",
        "# 4. Appariement (Blocking)\n",
        "# ========================\n",
        "\n",
        "results = []\n",
        "\n",
        "for i, r1 in df1.iterrows():\n",
        "    best_match, best_score = None, 0\n",
        "\n",
        "    # Blocking : candidats avec même sang\n",
        "    candidates = df2[df2[\"Blood Type\"] == r1[\"Blood Type\"]]\n",
        "\n",
        "    # Filtre fuzzy rapide (blocking approx sur nom)\n",
        "    candidates = candidates[\n",
        "        candidates[\"Name\"].apply(lambda x: fuzz.partial_ratio(r1[\"Name\"], x) > 70)\n",
        "    ]\n",
        "\n",
        "    for j, r2 in candidates.iterrows():\n",
        "        sim = compute_similarity(r1, r2)\n",
        "        if sim > best_score:\n",
        "            best_score = sim\n",
        "            best_match = (j, r2)\n",
        "\n",
        "    if best_match and best_score > 0.85:\n",
        "        results.append({\n",
        "            \"df1_index\": i,\n",
        "            \"df2_index\": best_match[0],\n",
        "            \"df1_name\": r1[\"Name\"],\n",
        "            \"df2_name\": best_match[1][\"Name\"],\n",
        "            \"Blood_Type\": r1[\"Blood Type\"],\n",
        "            \"Gender\": r1[\"Gender\"],\n",
        "            \"Age_df1\": r1[\"Age\"],\n",
        "            \"Age_df2\": best_match[1][\"Age\"],\n",
        "            \"similarity_score\": round(best_score, 3)\n",
        "        })\n",
        "\n",
        "# ========================\n",
        "# 5. Export résultats\n",
        "# ========================\n",
        "\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "# Export brut (uniquement appariements retenus par blocking)\n",
        "results_df.to_csv(\"matching_results_blocked.csv\", index=False)\n",
        "print(\"✅ Fichier 'matching_results_blocked.csv' généré avec\", len(results_df), \"appairages\")\n",
        "print(results_df.head())\n",
        "\n",
        "\n",
        "# ========================\n",
        "# 6. Evaluation + Statut\n",
        "# ========================\n",
        "\n",
        "def assign_status(score):\n",
        "    if score >= 0.90:\n",
        "        return \"match\"\n",
        "    elif score >= 0.75:\n",
        "        return \"ambiguous\"\n",
        "    else:\n",
        "        return \"no match\"\n",
        "\n",
        "# Ajouter la colonne status\n",
        "results_with_status = results_df.copy()\n",
        "results_with_status[\"status\"] = results_with_status[\"similarity_score\"].apply(assign_status)\n",
        "\n",
        "# Export enrichi\n",
        "results_with_status.to_csv(\"matching_results_with_status.csv\", index=False)\n",
        "print(\"✅ Fichier 'matching_results_with_status.csv' généré avec status\")\n",
        "\n",
        "\n",
        "# ========================\n",
        "# 7. Générer un ÉCHANTILLON élargi\n",
        "# ========================\n",
        "\n",
        "sample_non_matches = []\n",
        "\n",
        "# Tirer quelques exemples aléatoires non matches\n",
        "for i, r1 in df1.head(200).iterrows():  # limité à 200 lignes\n",
        "    candidates = df2.sample(5)  # 5 candidats aléatoires\n",
        "    for j, r2 in candidates.iterrows():\n",
        "        sim = compute_similarity(r1, r2)\n",
        "        sample_non_matches.append({\n",
        "            \"df1_index\": i,\n",
        "            \"df2_index\": j,\n",
        "            \"df1_name\": r1[\"Name\"],\n",
        "            \"df2_name\": r2[\"Name\"],\n",
        "            \"Blood_Type\": f\"{r1['Blood Type']} vs {r2['Blood Type']}\",\n",
        "            \"Gender\": f\"{r1['Gender']} vs {r2['Gender']}\",\n",
        "            \"Age_df1\": r1[\"Age\"],\n",
        "            \"Age_df2\": r2[\"Age\"],\n",
        "            \"similarity_score\": round(sim, 3),\n",
        "            \"status\": assign_status(sim)\n",
        "        })\n",
        "\n",
        "# Fusionner : un échantillon de matches + non matches\n",
        "examples_full = pd.concat([\n",
        "    results_with_status.sample(min(200, len(results_with_status))),  # matches\n",
        "    pd.DataFrame(sample_non_matches)  # non matches\n",
        "], ignore_index=True)\n",
        "\n",
        "# Export échantillon complet\n",
        "examples_full.to_csv(\"matching_examples_full.csv\", index=False)\n",
        "print(\"✅ Fichier 'matching_examples_full.csv' généré (matches + non matches)\")"
      ]
    },
