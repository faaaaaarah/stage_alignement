        "import pandas as pd\n",
        "import numpy as np\n",
        "import unicodedata\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "# =========================\n",
        "# 1. Fonction de nettoyage\n",
        "# =========================\n",
        "def clean_healthcare(df):\n",
        "    df = df.copy()\n",
        "    df.drop_duplicates(inplace=True)\n",
        "    df.columns = df.columns.str.strip()\n",
        "\n",
        "    for col in df.select_dtypes(include=['object']).columns:\n",
        "        df[col] = df[col].fillna(\"Unknown\").str.lower()\n",
        "        df[col] = df[col].apply(lambda x: ''.join(\n",
        "            c for c in unicodedata.normalize('NFKD', x)\n",
        "            if not unicodedata.combining(c)\n",
        "        ))\n",
        "        df[col] = df[col].str.strip()\n",
        "\n",
        "    for col in df.select_dtypes(include=[np.number]).columns:\n",
        "        df[col] = df[col].fillna(df[col].median())\n",
        "\n",
        "    return df\n",
        "\n",
        "# =========================\n",
        "# 2. Charger les datasets\n",
        "# =========================\n",
        "df1 = pd.read_csv(\"/content/healthcare_dataset.csv\")\n",
        "df2 = pd.read_csv(\"/content/healthcare_dataset2.csv\")\n",
        "\n",
        "df1 = clean_healthcare(df1)\n",
        "df2 = clean_healthcare(df2)\n",
        "\n",
        "# =========================\n",
        "# 3. Comparaison optimisée\n",
        "# =========================\n",
        "matches = []\n",
        "threshold = 0.85  # Seuil de similarité\n",
        "\n",
        "# On compare uniquement les groupes ayant même BloodType et même Genre\n",
        "for blood in df1['Blood Type'].unique():\n",
        "    for gender in df1['Gender'].unique():\n",
        "        sub1 = df1[(df1['Blood Type'] == blood) & (df1['Gender'] == gender)]\n",
        "        sub2 = df2[(df2['Blood Type'] == blood) & (df2['Gender'] == gender)]\n",
        "\n",
        "        if sub1.empty or sub2.empty:\n",
        "            continue\n",
        "\n",
        "        # Construction du texte pondéré : Nom a un poids fort\n",
        "        sub1['combined'] = (\n",
        "            sub1['Name'] + \" \" +\n",
        "            (sub1['Age'].astype(str) + \" \") * 1 +  # poids faible\n",
        "            (sub1['Gender'] + \" \") * 2 +           # poids moyen\n",
        "            (sub1['Blood Type'] + \" \") * 3 +       # poids fort\n",
        "            (sub1['Name'] + \" \") * 4               # nom répété pour poids fort\n",
        "        )\n",
        "\n",
        "        sub2['combined'] = (\n",
        "            sub2['Name'] + \" \" +\n",
        "            (sub2['Age'].astype(str) + \" \") * 1 +\n",
        "            (sub2['Gender'] + \" \") * 2 +\n",
        "            (sub2['Blood Type'] + \" \") * 3 +\n",
        "            (sub2['Name'] + \" \") * 4\n",
        "        )\n",
        "\n",
        "        # Vectorisation\n",
        "        vectorizer = TfidfVectorizer()\n",
        "        tfidf_1 = vectorizer.fit_transform(sub1['combined'])\n",
        "        tfidf_2 = vectorizer.transform(sub2['combined'])\n",
        "\n",
        "        # Similarité cosinus\n",
        "        sim_matrix = cosine_similarity(tfidf_1, tfidf_2)\n",
        "\n",
        "        for i in range(len(sub1)):\n",
        "            for j in range(len(sub2)):\n",
        "                if sim_matrix[i, j] >= threshold:\n",
        "                    matches.append({\n",
        "                        \"Dataset1\": sub1.iloc[i]['combined'],\n",
        "                        \"Dataset2\": sub2.iloc[j]['combined'],\n",
        "                        \"Score\": sim_matrix[i, j]\n",
        "                    })\n",
        "\n",
        "# =========================\n",
        "# 4. Résultats\n",
        "# =========================\n",
        "matches_df = pd.DataFrame(matches)\n",
        "matches_df.to_csv(\"/content/matches_optimized.csv\", index=False)\n",
        "print(\"✅ Comparaison terminée -\", len(matches_df), \"correspondances trouvées\")\n"
      ]
    },
