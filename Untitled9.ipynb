      "source": [
        "# ========================================\n",
        "# 1. Import des librairies\n",
        "# ========================================\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import unicodedata\n",
        "!pip install fuzzywuzzy python-Levenshtein\n",
        "\n",
        "\n",
        "# ========================================\n",
        "# 2. Fonction de nettoyage et normalisation\n",
        "# ========================================\n",
        "def clean_healthcare(df):\n",
        "    # --- Copie du dataframe pour ne pas modifier l'original ---\n",
        "    df = df.copy()\n",
        "\n",
        "    # --- Suppression des doublons ---\n",
        "    df.drop_duplicates(inplace=True)\n",
        "\n",
        "    # --- Suppression des espaces superflus dans les noms de colonnes ---\n",
        "    df.columns = df.columns.str.strip()\n",
        "\n",
        "    # --- Gestion des valeurs manquantes ---\n",
        "    # On remplace les valeurs vides dans les colonnes textuelles par \"Unknown\"\n",
        "    for col in df.select_dtypes(include=['object']).columns:\n",
        "        df[col] = df[col].fillna(\"Unknown\")\n",
        "\n",
        "    # On remplace les valeurs manquantes dans les colonnes numériques par la médiane\n",
        "    for col in df.select_dtypes(include=[np.number]).columns:\n",
        "        df[col] = df[col].fillna(df[col].median())\n",
        "\n",
        "    # --- Normalisation du texte ---\n",
        "    for col in df.select_dtypes(include=['object']).columns:\n",
        "        # Conversion en minuscules\n",
        "        df[col] = df[col].str.lower()\n",
        "        # Suppression des accents\n",
        "        df[col] = df[col].apply(lambda x: ''.join(\n",
        "            c for c in unicodedata.normalize('NFKD', x) if not unicodedata.combining(c)\n",
        "        ))\n",
        "        # Suppression des espaces en début/fin\n",
        "        df[col] = df[col].str.strip()\n",
        "\n",
        "    # --- Conversion cohérente des dates ---\n",
        "    date_cols = ['Date of Admission', 'Discharge Date']\n",
        "    for col in date_cols:\n",
        "        if col in df.columns:\n",
        "            df[col] = pd.to_datetime(df[col], errors='coerce')\n",
        "\n",
        "    # --- Normalisation des prix ---\n",
        "    if 'Billing Amount' in df.columns:\n",
        "        df['Billing Amount'] = df['Billing Amount'].apply(lambda x: float(str(x).replace(',', '').strip()))\n",
        "\n",
        "    # --- Normalisation du \"Length of Stay\" s'il existe ---\n",
        "    if 'Length of Stay' in df.columns:\n",
        "        df['Length of Stay'] = pd.to_numeric(df['Length of Stay'], errors='coerce').fillna(0).astype(int)\n",
        "\n",
        "    return df\n",
        "\n",
        "# ========================================\n",
        "# 3. Chargement des fichiers CSV\n",
        "# ========================================\n",
        "df1 = pd.read_csv(\"/content/healthcare_dataset.csv\")     # Dataset 1\n",
        "df2 = pd.read_csv(\"/content/healthcare_dataset2.csv\")    # Dataset 2\n",
        "\n",
        "# ========================================\n",
        "# 4. Nettoyage et normalisation\n",
        "# ========================================\n",
        "df1_clean = clean_healthcare(df1)\n",
        "df2_clean = clean_healthcare(df2)\n",
        "\n",
        "# 💡 Réduction du nombre de lignes pour éviter un crash mémoire\n",
        "df1_clean = df1_clean.head(5000)  # garde seulement les 5000 premières lignes\n",
        "df2_clean = df2_clean.head(5000)  # idem pour le 2e dataset\n",
        "\n",
        "# ========================================\n",
        "# 5. Sauvegarde des fichiers nettoyés\n",
        "# ========================================\n",
        "df1_clean.to_csv(\"/content/healthcare_dataset_clean.csv\", index=False)\n",
        "df2_clean.to_csv(\"/content/healthcare_dataset2_clean.csv\", index=False)\n",
        "\n",
        "print(\"✅ Nettoyage terminé. Les fichiers nettoyés ont été sauvegardés.\")\n",
        "print(\"Taille Dataset 1 :\", df1_clean.shape)\n",
        "print(\"Taille Dataset 2 :\", df2_clean.shape)\n"
      ]
    },
