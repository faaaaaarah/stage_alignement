      "source": [
        "import pandas as pd\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "# ============================\n",
        "# 1. Charger les fichiers CSV\n",
        "# ============================\n",
        "df1 = pd.read_csv(\"/content/healthcare_dataset.csv\")\n",
        "df2 = pd.read_csv(\"/content/healthcare_dataset2.csv\")\n",
        "\n",
        "# ============================\n",
        "# 2. Préparer les colonnes pour comparaison\n",
        "# ============================\n",
        "# On combine les colonnes en une seule chaîne pour chaque ligne\n",
        "df1[\"combined\"] = df1[[\"Name\", \"Age\", \"Gender\", \"Blood Type\"]].astype(str).agg(\" \".join, axis=1)\n",
        "df2[\"combined\"] = df2[[\"Name\", \"Age\", \"Gender\", \"Blood Type\"]].astype(str).agg(\" \".join, axis=1)\n",
        "\n",
        "# ============================\n",
        "# 3. TF-IDF Vectorisation\n",
        "# ============================\n",
        "vectorizer = TfidfVectorizer()\n",
        "tfidf_matrix_1 = vectorizer.fit_transform(df1[\"combined\"])\n",
        "tfidf_matrix_2 = vectorizer.transform(df2[\"combined\"])\n",
        "\n",
        "# ============================\n",
        "# 4. Calcul des similarités cosinus\n",
        "# ============================\n",
        "cosine_sim = cosine_similarity(tfidf_matrix_1, tfidf_matrix_2)\n",
        "\n",
        "# ============================\n",
        "# 5. Extraction des correspondances au-dessus d’un seuil\n",
        "# ============================\n",
        "threshold = 0.8  # 80% de similarité\n",
        "matches = []\n",
        "\n",
        "for i in range(len(df1)):\n",
        "    for j in range(len(df2)):\n",
        "        if cosine_sim[i][j] >= threshold:\n",
        "            matches.append({\n",
        "                \"Dataset1\": df1.loc[i, \"combined\"],\n",
        "                \"Dataset2\": df2.loc[j, \"combined\"],\n",
        "                \"Score\": cosine_sim[i][j]\n",
        "            })\n",
        "\n",
        "matches_df = pd.DataFrame(matches)\n",
        "print(matches_df)\n",
        "\n",
        "# Export si besoin\n",
        "matches_df.to_csv(\"/content/matches_tfidf.csv\", index=False)\n"
      ]
    },
